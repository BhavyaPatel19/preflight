# ---- LLM ----
# Default is a local model via Ollama (zero cost): `ollama serve` + `ollama pull qwen3:14b`.
# Set PREFLIGHT_LLM=anthropic with a key for the frontier comparison rows; =none to skip.
PREFLIGHT_LLM=ollama
PREFLIGHT_OLLAMA_MODEL=qwen3:14b
# Per-finding model calls in flight at once. Needs `make ollama-start` (OLLAMA_NUM_PARALLEL) to
# pay off; a hosted API batches on its own.
PREFLIGHT_LLM_CONCURRENCY=4
ANTHROPIC_API_KEY=
PREFLIGHT_ANTHROPIC_MODEL=claude-opus-5

# ---- Data sources ----
# aviationweather.gov needs no key.
# NOTAMs: the FAA API is not open to the public. NASA redistributes the feed via
# its Digital Information Platform (request access at https://dip.amesaero.nasa.gov).
# Leave blank until granted; `preflight ingest notams --file` works without it.
PREFLIGHT_NASA_DIP_BASE_URL=
PREFLIGHT_NASA_DIP_TOKEN=
# OpenSky: free account, optional for higher rate limits
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ---- Scheduler ----
# Airports kept current by `preflight schedule`. Default: 30 busiest US airports.
# PREFLIGHT_WATCHLIST=KSFO,KJFK,KBOS

# ---- Infra ----
# Native Postgres via Homebrew listens on 5433 (make db-start); the compose stack on 5432.
DATABASE_URL=postgresql://preflight:preflight@localhost:5433/preflight
REDIS_URL=redis://localhost:6379/0

# ---- Observability ----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
